# Copy to .env and fill in.
#
# Auth and identity (account id, extension id, API host) come from
# `nova-cli auth login-jwt` and are read from ~/.nova-cli/auth.env.
# nova_chat.py runs that login for you if you are not signed in.

# Required: the Nova assistant to chat with.
NOVA_ASSISTANT_ID=

# Optional: pin a version. Defaults to the assistant's published version.
# NOVA_VERSION_ID=

# Optional: Webchat (default). Inputs voice / sms / email normalize to PBX / SMS / Email.
# NOVA_CHANNEL=Webchat
